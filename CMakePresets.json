{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 22,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "description": "Base preset for the CH32V30x Black Magic Probe port",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "base-debug",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "ch32v30x_ob-release",
            "displayName": "CH32V30x BMP (Release)",
            "inherits": "base",
            "cacheVariables": {
                "BOARD": "ch32v30x_ob"
            },
            "binaryDir": "${sourceDir}/build/ch32v30x_ob-release"
        },
        {
            "name": "ch32v30x_ob-debug",
            "displayName": "CH32V30x BMP (Debug)",
            "inherits": "base-debug",
            "cacheVariables": {
                "BOARD": "ch32v30x_ob"
            },
            "binaryDir": "${sourceDir}/build/ch32v30x_ob-debug"
        },
        {
            "name": "ch32v30x_ob-slim",
            "displayName": "CH32V30x BMP (Slim, RISC-V/HPM only)",
            "description": "Size-optimised image: RISC-V RV32/HPM targets only. Applies patches/blackmagic-slim.patch to a private copy of the blackmagic sources; the submodule is left untouched.",
            "inherits": "base",
            "cacheVariables": {
                "BOARD": "ch32v30x_ob",
                "BMP_SLIM": "ON"
            },
            "binaryDir": "${sourceDir}/build/ch32v30x_ob-slim"
        },
        {
            "name": "ch32v30x_ob-ch32fun",
            "displayName": "CH32V30x BMP (ch32fun backend)",
            "description": "Builds against ch32fun instead of the WCH peripheral library. Same functionality as the default preset.",
            "inherits": "base",
            "cacheVariables": {
                "BOARD": "ch32v30x_ob",
                "BMP_CH32FUN": "ON"
            },
            "binaryDir": "${sourceDir}/build/ch32v30x_ob-ch32fun"
        }
    ],
    "buildPresets": [
        {
            "name": "ch32v30x_ob-release",
            "configurePreset": "ch32v30x_ob-release",
            "jobs": 8
        },
        {
            "name": "ch32v30x_ob-slim",
            "configurePreset": "ch32v30x_ob-slim",
            "jobs": 8
        },
        {
            "name": "ch32v30x_ob-ch32fun",
            "configurePreset": "ch32v30x_ob-ch32fun",
            "jobs": 8
        },
        {
            "name": "ch32v30x_ob-debug",
            "configurePreset": "ch32v30x_ob-debug",
            "jobs": 8
        }
    ]
}
